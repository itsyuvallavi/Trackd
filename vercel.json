{
  "functions": {
    "src/app/api/queues/bot-manual-run/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "trackd-bot-manual-runs",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-emails",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/auto-archive",
      "schedule": "0 2 * * *"
    }
  ]
}
